{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build:prerender",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/r/:shareId",
      "destination": "/api/og/:shareId"
    },
    {
      "source": "/(login|signup|forgot-password|reset-password|account|payment-demo|vibelevel)",
      "destination": "/app.html"
    },
    {
      "source": "/(admin|dashboard|pm)(/.*)?",
      "destination": "/app.html"
    },
    {
      "source": "/(q|r-view|showcase)/:id",
      "destination": "/app.html"
    },
    {
      "source": "/tools/(cost-estimator|roi-calculator|timeline-calculator|tech-recommender|maintenance-calculator)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), payment=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://cdn.razorpay.com https://www.googletagmanager.com https://*.clarity.ms https://app.cal.com; connect-src 'self' https://*.supabase.co https://api.razorpay.com https://api.openai.com https://api.resend.com https://*.google-analytics.com https://*.analytics.google.com https://*.clarity.ms https://app.cal.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; frame-src https://api.razorpay.com https://app.cal.com https://cal.com"
        }
      ]
    },
    {
      "source": "/q/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/crm-digest",
      "schedule": "30 2 * * *"
    }
  ]
}
